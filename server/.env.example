# 이 파일을 복사해 .env 로 만들고 값을 채운다. (.env 는 git에 올라가지 않는다 — NFR-04)

# 개발: 각자 PC의 SQLite 파일 DB (설치·네트워크 불필요)
DATABASE_URL=sqlite:///./data/leona.db

# 통합 테스트: 학교 Oracle (oracledb 설치 필요). 계정·비밀번호는 직접 입력한다.
# DATABASE_URL=oracle+oracledb://<계정>:<비밀번호>@<호스트>:<포트>/?service_name=<서비스명>

# 메일 원문(.eml)·첨부파일 저장 폴더 (DB에는 경로만 저장)
STORAGE_DIR=./storage

# 추출(B)·검증(C)·견적서 생성 연결
#   off    = 연결 안 함 (기본)
#   rules  = 키워드 사전·정규식만 (LLM 없이 동작)
#   hybrid = 룰 + 로컬 LLM (Ollama 설치 후 `ollama pull qwen3:8b`)
# LLM 주소는 localhost 또는 사내망(사설 IP)만 허용된다. 외부 주소면 LLM을 쓰지 않고 룰만으로 진행한다 (NFR-04).
EXTRACTION_MODE=off
LLM_URL=http://localhost:11434
LLM_MODEL=qwen3:8b
# 생각(thinking) 모드: 켜면 느려져 60초(NFR-02)를 넘기기 쉽다
LLM_THINK=false
LLM_TIMEOUT_S=45
LLM_NUM_CTX=8192

# 견적서 PDF: LibreOffice(무료, https://www.libreoffice.org)가 설치돼 있으면 XLSX와 함께 PDF도 만든다.
# 설치 경로가 기본값이 아니면 SOFFICE_PATH=C:\경로\soffice.exe 로 지정. 끄려면 QUOTE_PDF=false
QUOTE_PDF=true
